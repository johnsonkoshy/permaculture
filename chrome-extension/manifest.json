{
  "manifest_version": 3,
  "name": "EBPG Posting Helper",
  "short_name": "EBPG Helper",
  "version": "1.0.0",
  "description": "Fills East Bay Permaculture Guild event posts into Partiful, Luma, Meetup, Facebook and Hylo. You review and publish.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "EBPG Posting Helper",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "pages/sidepanel.html"
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://ebpg-event-hub.netlify.app/*", "http://localhost:8766/*"],
      "js": ["src/shared.js", "src/hub-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.partiful.com/*",
        "https://*.lu.ma/*",
        "https://*.luma.com/*",
        "https://*.meetup.com/*",
        "https://*.facebook.com/*",
        "https://*.hylo.com/*"
      ],
      "js": ["src/shared.js", "src/filler.js", "src/panel.js", "src/site.js"],
      "run_at": "document_idle"
    }
  ]
}
